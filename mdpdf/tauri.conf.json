{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdpdf",
  "version": "1.8.0",
  "identifier": "com.alfoirazabal.mdpdf",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MDPDF",
        "width": 890,
        "height": 540,
        "resizable": true,
        "center": true,
        "minWidth": 890,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon_32.png", "icons/icon_128.png", "icons/icon_256.png"]
  }
}
